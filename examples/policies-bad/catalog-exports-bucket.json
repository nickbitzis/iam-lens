{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PartnerUpload",
      "Effect": "Allow",
      "Principal": {
        "AWS": "*"
      },
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::cobaltline-catalog-staging-exports",
        "arn:aws:s3:::cobaltline-catalog-staging-exports/*"
      ]
    }
  ]
}
